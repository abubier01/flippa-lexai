# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server secrets
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STRIPE_SECRET_KEY=sk_test_replace_me
GROQ_API_KEY=replace_me
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Optional pricing overrides
PRICE_PRO_CENTS=2900
PRICE_TEAM_CENTS=9900

# Optional admin migration/seed APIs
# Default behavior in production is disabled unless this is true.
ENABLE_ADMIN_ROUTES=false
# Option A: machine access key for /api/admin/* endpoints
ADMIN_API_KEY=replace_with_long_random_secret
# Option B: user-session allowlist fallback when ADMIN_API_KEY is unset
ADMIN_EMAIL_ALLOWLIST=owner@example.com

# Optional migration helpers used by admin scripts/routes
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
POSTGRES_URL=postgresql://...
POSTGRES_URL_NON_POOLING=postgresql://...

# Optional auth redirect override for local dev
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/dashboard

# Stripe entitlement hardening (PR-1)
STRIPE_WEBHOOK_SECRET=whsec_from_dashboard_webhook_endpoint
STRIPE_PRICE_PRO_MONTHLY=price_pro_test_or_live
STRIPE_PRICE_TEAM_MONTHLY=price_team_test_or_live
STRIPE_PORTAL_RETURN_URL=https://flippa-lexai.vercel.app/settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_from_stripe_api_keys
