# Upstash Redis (auto-injected by the Vercel Marketplace integration in production
# and preview environments). Optional locally — when absent, lib/security/rate-limit.ts
# falls back to an in-memory shim suitable for `npm run dev` and CI.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase client settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: if set, signup confirmation emails will redirect here after verification.
# If empty, Supabase falls back to the project's Site URL from Auth URL Configuration.
NEXT_PUBLIC_SUPABASE_EMAIL_REDIRECT_URL=

# Optional: set to true only when Vercel Web Analytics is enabled for this project.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# Kill-switch for structured contract analysis.
# Set to false to disable POST /api/contracts/analyze.
ANALYSIS_ENABLED=true

# QStash cron signature verification (https://docs.upstash.com/qstash)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Healthchecks.io heartbeat URL for the reap cron deadman alert
# Optional in dev (heartbeat skipped if unset); required in prod.
HEALTHCHECK_REAP_URL=

# Sentry error tracking.
# Set in Vercel for Production + Preview ONLY — leave unset locally so
# `npm run dev` stays Sentry-free (the SDK is a no-op when DSN is absent).
# See docs/runbooks/sentry-troubleshooting.md for setup details.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for build-time source map upload (scopes: org:read,
# project:releases, project:write). Sensitive — do not commit.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry → Slack bridge (free-plan workaround; native Slack integration
# requires Sentry Team plan or above). The Sentry Internal Integration signs
# every webhook with HMAC-SHA256; /api/sentry-webhook verifies the signature.
# - SENTRY_WEBHOOK_SECRET: client secret from the Internal Integration.
# - SLACK_WEBHOOK_URL: Slack Incoming Webhook URL pointing at #lexai-errors.
# Set both in Vercel Production only — preview/dev do not page Slack.
SENTRY_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
